# Copy this file to .env.local and replace the host with your computer's LAN IPv4.
# The phone and computer must be connected to the same Wi-Fi network.
# Keep this value as the API base URL; the app appends /api/v1 itself.
# Do not add credentials, tokens, or other secrets to EXPO_PUBLIC_* variables.
EXPO_PUBLIC_API_URL=http://192.168.1.50:3000

# If you are using a reachable HTTPS staging/deployed API instead of a local API,
# replace the value above with its base URL, for example:
# EXPO_PUBLIC_API_URL=https://api-bopacorp.jointrymyride.com

# NPM_TOKEN is intentionally not included here. Set it only in your shell before
# npm ci; it authenticates the private @bopacorp/shared package in GitHub Packages.
